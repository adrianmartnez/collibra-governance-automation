# Secrets and connection material stay in the environment (or this file locally).
# Do not put passwords, tokens, or database URLs into governance.yaml — use *_env refs only.
# Optional GaC profile selection when using --config:
# GOVERNANCE_PROFILE=ci

# Local demo PostgreSQL credentials (fictional / safe for local use only).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=governance_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional: override individual settings with a single URL.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/governance_demo

POSTGRES_SOURCE_NAME=governance-demo
INVENTORY_OUTPUT_PATH=artifacts/metadata-inventory.json

LOG_LEVEL=INFO

# Collibra adapter configuration. Default mock mode needs no credentials.
COLLIBRA_MODE=mock
COLLIBRA_BASE_URL=
COLLIBRA_TIMEOUT_SECONDS=10

# Live mode requires COLLIBRA_BASE_URL and exactly one auth method:
# Basic: COLLIBRA_USERNAME + COLLIBRA_PASSWORD
# Bearer: COLLIBRA_BEARER_TOKEN (caller-supplied)
# OAuth client credentials: COLLIBRA_CLIENT_ID + COLLIBRA_CLIENT_SECRET
COLLIBRA_USERNAME=
COLLIBRA_PASSWORD=
COLLIBRA_BEARER_TOKEN=
COLLIBRA_CLIENT_ID=
COLLIBRA_CLIENT_SECRET=

# External IdP only. Native Collibra OAuth uses POST {base}/rest/oauth/v2/token
# and rejects token_url, scope, and oauth_client_auth.
# COLLIBRA_TOKEN_URL=
# COLLIBRA_OAUTH_SCOPE=
# COLLIBRA_OAUTH_CLIENT_AUTH=client_secret_post

# Execution path: core_rest | import_v2 | sync_v2
COLLIBRA_EXECUTION_MODE=core_rest
# Optional UUID override for sync_v2 (otherwise derived from source + endpoint)
# COLLIBRA_SYNCHRONIZATION_ID=

# Batch ceilings may only lower the hard maxima (50000 resources / 500000 additional characteristics)
# COLLIBRA_BATCH_MAX_RESOURCES=50000
# COLLIBRA_BATCH_MAX_ADDITIONAL_CHARACTERISTICS=500000

# Operational telemetry: default off. jsonl writes to stderr, or to COLLIBRA_TELEMETRY_PATH.
# Never mix telemetry into CLI stdout JSON.
# COLLIBRA_TELEMETRY=jsonl
# COLLIBRA_TELEMETRY_PATH=

# Tenant-specific domain/type UUIDs are supplied via CollibraMappingConfig, not this file.
