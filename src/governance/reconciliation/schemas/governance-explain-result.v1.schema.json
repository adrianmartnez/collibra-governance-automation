{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:collibra-governance-automation:schema:governance-explain-result:1",
  "title": "Governance explain result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "explain_schema",
    "explain_version",
    "namespace",
    "object",
    "properties",
    "writes_performed",
    "content_identity"
  ],
  "properties": {
    "explain_schema": { "type": "string", "const": "governance-explain-result" },
    "explain_version": { "type": "string", "const": "1" },
    "namespace": { "type": "string", "minLength": 1 },
    "object": { "type": "object" },
    "properties": {
      "type": "array",
      "items": { "type": "object" }
    },
    "writes_performed": { "type": "integer", "const": 0 },
    "content_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "hashing_contract_version", "digest"],
      "properties": {
        "algorithm": { "type": "string", "const": "sha256" },
        "hashing_contract_version": { "type": "string", "const": "1" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
