{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:collibra-governance-automation:schema:governance-history-evolution:1",
  "title": "Governance history evolution v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evolution_schema",
    "evolution_version",
    "history_content_identity",
    "queried_object",
    "queried_governance_object",
    "queried_property",
    "comparison_policy",
    "transitions",
    "writes_performed",
    "content_identity"
  ],
  "properties": {
    "evolution_schema": {
      "type": "string",
      "const": "governance-history-evolution"
    },
    "evolution_version": { "type": "string", "const": "1" },
    "history_content_identity": { "$ref": "#/$defs/contentIdentity" },
    "queried_object": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/comparisonObjectIdentity" }]
    },
    "queried_governance_object": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/graphNodeIdentity" }]
    },
    "queried_property": {
      "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "pattern": "^/" }]
    },
    "comparison_policy": { "$ref": "#/$defs/comparisonPolicy" },
    "transitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/transition" }
    },
    "writes_performed": { "type": "integer", "const": 0 },
    "content_identity": { "$ref": "#/$defs/contentIdentity" }
  },
  "allOf": [
    { "$ref": "#/$defs/noCredentialControlFields" },
    {
      "anyOf": [
        { "not": { "properties": { "queried_object": { "type": "null" } } } },
        { "not": { "properties": { "queried_governance_object": { "type": "null" } } } }
      ]
    }
  ],
  "$defs": {
    "contentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "hashing_contract_version", "digest"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1 },
        "hashing_contract_version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 }
      }
    },
    "comparisonPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["align_source_roots", "align_database_roots"],
      "properties": {
        "align_source_roots": { "type": "boolean" },
        "align_database_roots": { "type": "boolean" }
      }
    },
    "comparisonObjectIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "data_source",
            "database",
            "schema",
            "table",
            "column",
            "primary_key",
            "foreign_key",
            "relationship"
          ]
        },
        "path": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "graphNodeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "kind", "logical_id", "parent"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "logical_id": { "type": "string", "minLength": 1 },
        "parent": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/graphNodeIdentity" }]
        }
      }
    },
    "comparablePropertyValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["has_value"],
          "properties": { "has_value": { "type": "boolean", "const": false } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["has_value", "value"],
          "properties": {
            "has_value": { "type": "boolean", "const": true },
            "value": true
          }
        }
      ]
    },
    "objectChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "object_identity", "parent_identity", "property_changes"],
      "properties": {
        "change": { "type": "string", "enum": ["added", "removed", "changed"] },
        "object_identity": { "$ref": "#/$defs/comparisonObjectIdentity" },
        "parent_identity": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/comparisonObjectIdentity" }]
        },
        "property_changes": {
          "type": "array",
          "items": { "$ref": "#/$defs/propertyChange" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "change": { "enum": ["added", "removed"] } },
            "required": ["change"]
          },
          "then": {
            "properties": {
              "property_changes": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "change": { "const": "changed" } },
            "required": ["change"]
          },
          "then": {
            "properties": {
              "property_changes": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "propertyChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "baseline", "candidate"],
      "properties": {
        "property": { "type": "string", "minLength": 1, "pattern": "^/" },
        "baseline": { "$ref": "#/$defs/comparablePropertyValue" },
        "candidate": { "$ref": "#/$defs/comparablePropertyValue" }
      }
    },
    "snapshotProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "baseline", "candidate"],
      "properties": {
        "property": { "type": "string", "minLength": 1, "pattern": "^/" },
        "baseline": { "$ref": "#/$defs/comparablePropertyValue" },
        "candidate": { "$ref": "#/$defs/comparablePropertyValue" }
      }
    },
    "sideAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate"],
      "properties": {
        "baseline": { "type": "boolean" },
        "candidate": { "type": "boolean" }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "provenance", "authority_decision", "conflict"],
      "properties": {
        "snapshot": { "$ref": "#/$defs/sideAvailability" },
        "provenance": { "$ref": "#/$defs/sideAvailability" },
        "authority_decision": { "$ref": "#/$defs/sideAvailability" },
        "conflict": { "$ref": "#/$defs/sideAvailability" }
      }
    },
    "provenanceProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value_groups"],
      "properties": {
        "value_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "provenance"],
            "properties": {
              "value": true,
              "provenance": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/provenanceRecord" }
              }
            }
          }
        }
      }
    },
    "provenanceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_type", "source_ref", "source_version", "observation_mode"],
      "properties": {
        "provider_type": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "source_version": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "observation_mode": {
          "type": "string",
          "enum": ["declared", "observed", "derived"]
        }
      }
    },
    "conflictState": {
      "type": "string",
      "enum": [
        "SINGLE_OBSERVATION",
        "AGREEMENT",
        "RESOLVED_BY_AUTHORITY",
        "UNRESOLVED_CONFLICT",
        "INVALID_OR_AMBIGUOUS_AUTHORITY"
      ]
    },
    "conflictReason": {
      "type": "string",
      "enum": [
        "SINGLE_OBSERVATION",
        "AGREEMENT",
        "RESOLVED_BY_AUTHORITY",
        "NO_AUTHORITY_RULE",
        "AUTHORITATIVE_SOURCE_NOT_OBSERVED",
        "AUTHORITATIVE_SOURCE_CONFLICTED",
        "INVALID_OR_AMBIGUOUS_AUTHORITY"
      ]
    },
    "authorityRuleKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "select"],
      "properties": {
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider_type"],
          "properties": {
            "provider_type": { "type": "string", "minLength": 1 },
            "source_ref": { "type": "string", "minLength": 1 }
          }
        },
        "select": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "property"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "data_source",
                "dataset",
                "table",
                "column",
                "contract",
                "transformation"
              ]
            },
            "property": { "type": "string", "minLength": 1 },
            "namespace": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "conflictStateProjection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["has_result"],
          "properties": { "has_result": { "type": "boolean", "const": false } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["has_result", "state", "reason"],
          "properties": {
            "has_result": { "type": "boolean", "const": true },
            "state": { "$ref": "#/$defs/conflictState" },
            "reason": { "$ref": "#/$defs/conflictReason" }
          }
        }
      ]
    },
    "authorityDecisionProjection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["has_result"],
          "properties": { "has_result": { "type": "boolean", "const": false } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["has_result", "authority_applicable"],
          "properties": {
            "has_result": { "type": "boolean", "const": true },
            "authority_applicable": { "type": "boolean", "const": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["has_result", "authority_applicable", "outcome", "winning_rule_key"],
          "properties": {
            "has_result": { "type": "boolean", "const": true },
            "authority_applicable": { "type": "boolean", "const": true },
            "outcome": {
              "type": "string",
              "enum": [
                "NO_AUTHORITY_RULE",
                "INVALID_OR_AMBIGUOUS_AUTHORITY",
                "AUTHORITATIVE_SOURCE_NOT_OBSERVED",
                "AUTHORITATIVE_SOURCE_CONFLICTED",
                "RESOLVED_BY_AUTHORITY"
              ]
            },
            "winning_rule_key": {
              "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/authorityRuleKey" }]
            }
          }
        }
      ]
    },
    "effectiveValueProjection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["has_result"],
          "properties": { "has_result": { "type": "boolean", "const": false } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["has_result", "has_effective_value"],
          "properties": {
            "has_result": { "type": "boolean", "const": true },
            "has_effective_value": { "type": "boolean", "const": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["has_result", "has_effective_value", "value"],
          "properties": {
            "has_result": { "type": "boolean", "const": true },
            "has_effective_value": { "type": "boolean", "const": true },
            "value": true
          }
        }
      ]
    },
    "dimensionChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate"],
      "properties": {
        "baseline": true,
        "candidate": true
      }
    },
    "contextDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "change"],
      "properties": {
        "available": { "$ref": "#/$defs/sideAvailability" },
        "change": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/dimensionChange" }]
        }
      }
    },
    "contextPropertyChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property",
        "provenance",
        "conflict",
        "authority_decision",
        "effective_value"
      ],
      "properties": {
        "property": { "type": "string", "minLength": 1, "pattern": "^/" },
        "provenance": { "$ref": "#/$defs/contextDimension" },
        "conflict": { "$ref": "#/$defs/contextDimension" },
        "authority_decision": { "$ref": "#/$defs/contextDimension" },
        "effective_value": { "$ref": "#/$defs/contextDimension" }
      }
    },
    "snapshotBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_change", "property"],
      "properties": {
        "object_change": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/objectChange" }]
        },
        "property": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/snapshotProperty" }]
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_index",
        "to_index",
        "from_entry_state_identity",
        "to_entry_state_identity",
        "from_snapshot_identity",
        "to_snapshot_identity",
        "availability",
        "snapshot",
        "context_property_changes"
      ],
      "properties": {
        "from_index": { "type": "integer", "minimum": 0 },
        "to_index": { "type": "integer", "minimum": 1 },
        "from_entry_state_identity": { "$ref": "#/$defs/contentIdentity" },
        "to_entry_state_identity": { "$ref": "#/$defs/contentIdentity" },
        "from_snapshot_identity": { "$ref": "#/$defs/contentIdentity" },
        "to_snapshot_identity": { "$ref": "#/$defs/contentIdentity" },
        "availability": { "$ref": "#/$defs/availability" },
        "snapshot": { "$ref": "#/$defs/snapshotBranch" },
        "context_property_changes": {
          "type": "array",
          "items": { "$ref": "#/$defs/contextPropertyChange" }
        }
      }
    },
    "noCredentialControlFields": {
      "not": {
        "anyOf": [
          { "required": ["password"] },
          { "required": ["token"] },
          { "required": ["client_secret"] },
          { "required": ["authorization"] },
          { "required": ["credentials"] },
          { "required": ["api_key"] },
          { "required": ["secret"] }
        ]
      }
    }
  }
}
