{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:collibra-governance-automation:schema:governance-history-diagnostics:1",
  "title": "Governance history diagnostics v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagnostic_schema", "diagnostic_version", "ok", "errors"],
  "properties": {
    "diagnostic_schema": {
      "type": "string",
      "const": "governance-history-diagnostics"
    },
    "diagnostic_version": { "type": "string", "const": "1" },
    "ok": { "type": "boolean", "const": false },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/diagnosticError" }
    }
  },
  "$defs": {
    "diagnosticError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
