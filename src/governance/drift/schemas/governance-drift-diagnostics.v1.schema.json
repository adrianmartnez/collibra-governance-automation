{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:collibra-governance-automation:schema:governance-drift-diagnostics:1",
  "title": "Governance drift diagnostics v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagnostic_schema", "diagnostic_version", "ok", "errors"],
  "properties": {
    "diagnostic_schema": { "type": "string", "const": "governance-drift-diagnostics" },
    "diagnostic_version": { "type": "string", "const": "1" },
    "ok": { "type": "boolean", "const": false },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/diagnosticError" }
    }
  },
  "$defs": {
    "diagnosticError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "comparison_read_error",
            "comparison_parse_error",
            "invalid_comparison_artifact",
            "unsupported_comparison_schema",
            "unsupported_comparison_version",
            "comparison_integrity_mismatch",
            "policy_read_error",
            "policy_parse_error",
            "invalid_policy",
            "ambiguous_drift_policy",
            "missing_drift_policy",
            "write_error"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
