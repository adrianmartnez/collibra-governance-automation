{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:collibra-governance-automation:schema:governance-policy:1",
  "title": "Governance policy file v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_schema", "policy_version", "policies"],
  "properties": {
    "policy_schema": {
      "type": "string",
      "const": "governance-policy"
    },
    "policy_version": {
      "type": "string",
      "const": "1"
    },
    "policies": {
      "type": "array",
      "items": { "$ref": "#/$defs/policy" }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "rule"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["error", "warning"] },
        "rule": { "$ref": "#/$defs/rule" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "select"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["require_owner", "require_description", "require_relationship"]
        },
        "select": { "$ref": "#/$defs/select" }
      }
    },
    "select": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "data_source",
            "database",
            "schema",
            "table",
            "column",
            "relationship"
          ]
        },
        "id": { "type": "string", "minLength": 1 },
        "id_prefix": { "type": "string", "minLength": 1 }
      }
    }
  }
}
