{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:collibra-governance-automation:schema:governance-config:2",
  "title": "Governance-as-Code configuration v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2",
      "description": "Configuration contract version. Only \"2\" is accepted by the v2 loader."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "Logical discovery sources. Provider-neutral; one or more entries.",
      "items": { "$ref": "#/$defs/providerBound" }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "description": "Optional governance targets. When present, one or more provider-neutral entries.",
      "items": { "$ref": "#/$defs/providerBound" }
    },
    "artifacts": {
      "$ref": "#/$defs/artifacts",
      "description": "Optional output path configuration relative to the config file directory."
    },
    "policies": {
      "$ref": "#/$defs/policies",
      "description": "Declarative policy file references."
    },
    "authority": {
      "$ref": "#/$defs/authority",
      "description": "Declarative metadata authority file references."
    },
    "profiles": {
      "type": "object",
      "description": "Named overlays selected via CLI --profile or GOVERNANCE_PROFILE.",
      "additionalProperties": { "$ref": "#/$defs/profileOverlay" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "description": "POSIX-relative path under the config file directory. Must not escape via .."
    },
    "providerId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "description": "Stable provider_id matching the Provider SDK identity contract."
    },
    "logicalId": {
      "type": "string",
      "minLength": 1,
      "description": "Logical source or target identifier (unique within its collection)."
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inventory_path": { "$ref": "#/$defs/relativePath" },
        "snapshot_path": { "$ref": "#/$defs/relativePath" }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "profileOverlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/providerBound" }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/providerBound" }
        },
        "artifacts": { "$ref": "#/$defs/artifacts" },
        "policies": { "$ref": "#/$defs/policies" },
        "authority": { "$ref": "#/$defs/authority" }
      }
    },
    "providerBound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "config"],
      "properties": {
        "id": { "$ref": "#/$defs/logicalId" },
        "provider": { "$ref": "#/$defs/providerId" },
        "config": {
          "type": "object",
          "description": "Bounded provider-specific payload. Deep JSON-compat and $env shape are validated in core semantics."
        }
      }
    }
  }
}
